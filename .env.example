# --- Obrigatórias na Vercel (Project Settings > Environment Variables) ---

# Neon, conexão COM pooler (hostname tem "-pooler"). Mantém ?sslmode=require
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require"

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="gere-um-valor-aleatorio-de-64-caracteres"

# URL pública do projeto na Vercel, sem barra no final
NEXT_PUBLIC_BASE_URL="https://seu-projeto.vercel.app"

# ImageKit: dashboard > Developer options > API Keys (só a Private Key)
IMAGEKIT_PRIVATE_KEY="private_xxxxxxxxxxxxxxxxxxxxxxxx"

# --- Só no seu PC, pra rodar "prisma migrate deploy" e "prisma db seed" ---

# Neon, conexão SEM pooler (a mesma, sem "-pooler" no hostname)
DATABASE_URL_UNPOOLED="postgresql://USUARIO:SENHA@ep-xxxx.regiao.aws.neon.tech/neondb?sslmode=require"

# Login do painel criado pelo seed (sem isso, cai no padrão de teste admin123)
ADMIN_EMAIL="seu-email@exemplo.com"
ADMIN_PASSWORD="coloque-uma-senha-forte-aqui"
